# Copy to .env (never commit .env). Used by both docker-compose and the backend.

# --- Application ---
APP_NAME=SYNTHORA
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Infrastructure names intentionally keep "researchmind" (renaming would orphan the Docker volume).
# Use 127.0.0.1, not localhost: Docker publishes the port on IPv4 only, and on Windows
# "localhost" tries IPv6 ::1 first (about 2 seconds per connection before falling back).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=researchmind

# Integration tests ONLY ever touch this database. Must end in "_test".
TEST_POSTGRES_DB=researchmind_test

# --- Connection pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_ECHO=false

# --- JWT authentication ---
# REQUIRED. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this placeholder is still here.
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=synthora-api
JWT_AUDIENCE=synthora-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Paper file storage ---
# Where uploaded PDFs are stored. Relative paths are resolved against the PROJECT ROOT
# (the folder containing this file), not the current directory. Keep it out of Git.
PAPER_STORAGE_DIR=storage
# Maximum size of one uploaded PDF, in MB (1 MB = 1024 * 1024 bytes). Allowed: 1-512.
MAX_UPLOAD_SIZE_MB=25

# --- PDF text extraction ---
# PDFs with more pages are rejected (failure_code = too_many_pages). Allowed: 1-20000.
EXTRACTION_MAX_PAGES=2000
# A paper stuck in "processing" longer than this (e.g. after a crash) can be extracted again.
EXTRACTION_STALE_MINUTES=15

# --- GROBID document structure (Day 6) ---
# Optional. Start it with: docker compose up -d grobid
# When disabled or unreachable, extraction still succeeds with page-based chunks.
GROBID_ENABLED=true
# Base URL only. Use 127.0.0.1, not localhost (same Windows IPv6 delay as PostgreSQL).
GROBID_URL=http://127.0.0.1:8070
# Host port published by docker-compose (keep it equal to the port in GROBID_URL).
GROBID_PORT=8070
# Seconds allowed for one full-text request. Allowed: 5-600.
GROBID_TIMEOUT_SECONDS=120
# Detect ruled tables with PyMuPDF so their text becomes separate table chunks (~0.1 s per page).
EXTRACTION_DETECT_TABLES=true

# --- Chunking (Day 6) ---
# Sizes in the unit of CHUNK_TOKEN_COUNTER (WORDS by default). Must satisfy MIN < TARGET <= MAX.
CHUNK_TARGET_WORDS=350
CHUNK_MAX_WORDS=500
CHUNK_MIN_WORDS=60
# word_proxy (default) or tokenizer. "tokenizer" needs the optional `tokenizers` package and an
# existing local tokenizer.json; nothing is downloaded. If either is missing, word_proxy is used.
CHUNK_TOKEN_COUNTER=word_proxy
# CHUNK_TOKENIZER_FILE=D:/models/bge-small-en-v1.5/tokenizer.json
CHUNK_TOKENIZER_NAME=BAAI/bge-small-en-v1.5
