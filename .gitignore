# ==============================
# SYNTHORA - Git Ignore
# ==============================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Logs
*.log
logs/

# Uploaded files and runtime storage
storage/
uploads/
temp/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Build and distribution
build/
dist/

# Jupyter Notebook
.ipynb_checkpoints/

# Node.js (frontend - future)
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend build output
.next/
out/

# Never commit research PDFs or in-progress upload files (Day 4)
*.pdf
*.part
